<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>Sample feed</title>
    <link>https://example.com/</link>
    <description>Фикстура для тестов RSS-сборщика</description>
    <item>
      <title>Запись с pubDate</title>
      <link>https://example.com/with-pubdate</link>
      <description>Есть дата публикации</description>
      <pubDate>Mon, 09 Nov 2026 10:00:00 +0000</pubDate>
    </item>
    <item>
      <title>Запись только с updated</title>
      <link>https://example.com/only-updated</link>
      <description>Есть только дата обновления</description>
      <atom:updated>2026-11-08T12:30:00Z</atom:updated>
    </item>
    <item>
      <title>Запись без даты</title>
      <link>https://example.com/no-date</link>
      <description>Даты нет вообще</description>
    </item>
  </channel>
</rss>
